{
  "venvPath": "backend",
  "venv": ".venv",
  "pythonVersion": "3.14",
  "extraPaths": ["backend"],
  "include": [
    "backend/shared",
    "backend/app-service",
    "backend/identity-service",
    "backend/stats-service",
    "backend/tournament-service",
    "backend/discord-service",
    "backend/balancer-service",
    "backend/analytics-service",
    "backend/stream-service"
  ],
  "exclude": [
    "**/__pycache__",
    "**/.venv",
    "**/htmlcov",
    "**/logs",
    "**/alembic",
    "backend/migrations"
  ]
}
