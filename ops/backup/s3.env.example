# Timeweb S3 credentials for ops/backup/backup.sh
#   cp ops/backup/s3.env.example ops/backup/s3.env && chmod 600 ops/backup/s3.env
#
# Prod on Moscow lives at /root/pg-backup/s3.env (same keys).

RCLONE_CONFIG_TW_TYPE=s3
RCLONE_CONFIG_TW_PROVIDER=Other
RCLONE_CONFIG_TW_ACCESS_KEY_ID=
RCLONE_CONFIG_TW_SECRET_ACCESS_KEY=
RCLONE_CONFIG_TW_ENDPOINT=https://s3.twcstorage.ru
RCLONE_CONFIG_TW_REGION=ru-1
RCLONE_CONFIG_TW_FORCE_PATH_STYLE=false
BUCKET=
