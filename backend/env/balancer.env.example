# balancer-service overrides. Shared settings (POSTGRES_*, REDIS_URL, RABBITMQ_URL, ...)
# come from common.env; see the balancer-service README for the knobs that apply.

# Deadlock bot lobby and ingest status call deadlock-api. Unset = its public per-IP limits;
# with a key (sent as X-API-KEY) the per-key limits apply. Set the same key in stats.env.
# DEADLOCK_API_KEY=your_deadlock_api_key
# The bot lobby's callback URL is built from PUBLIC_SITE_URL (common.env): it must be the public origin,
# or the callback is left out and only the 60 s poll finds the match id.
