# Master secret (>= 32 random chars), read by identity only. Every identity key is derived from it: the
# Ed25519 key access/service JWTs are signed with (HKDF info "anak-identity:jwt-signing:v1"), refresh-token and
# API-key hashing, OAuth state. Changing it signs everyone out and changes the gateway's JWT_PUBLIC_KEY:
# re-run `make jwt-public-key` into gateway.env.
JWT_SECRET_KEY=your_jwt_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Service-to-service auth (client credentials)
# No in-repo service mints one today (discord-service uploads logs over RabbitMQ); define a caller only for a new one.
# JSON examples:
# SERVICE_CLIENTS={"<caller>":"secret"}
# SERVICE_SCOPES={"<caller>":["<scope>"]}
# Scopes identity checks: identity:invalidate (rpc.identity.invalidate_session, drop a user's cached RBAC).
SERVICE_CLIENTS={}
SERVICE_SCOPES={}
SERVICE_ACCESS_TOKEN_EXPIRE_MINUTES=5
SERVICE_TOKEN_ISSUER=auth-service
SERVICE_TOKEN_AUDIENCE=internal

DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Seals the Discord and Twitch tokens identity keeps (AES-256-GCM); no other provider's token is stored. Required
# while Discord or Twitch OAuth is enabled (identity refuses to start without it), and the SAME value goes into
# stats.env and tournament.env, which read the Twitch tokens. Generate once, never rotate casually (stored tokens
# stop opening; users re-link):
#   python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
OAUTH_TOKEN_ENCRYPTION_KEY=

BATTLENET_CLIENT_ID=your_battlenet_client_id
BATTLENET_CLIENT_SECRET=your_battlenet_client_secret
BATTLENET_REGION=eu

RIOT_OAUTH_ENABLED=false
RIOT_CLIENT_ID=your_riot_rso_client_id
RIOT_CLIENT_SECRET=your_riot_rso_client_secret
RIOT_ACCOUNT_CLUSTER=europe

# Steam OpenID 2.0: no client id/secret, only OAUTH_REDIRECT (its scheme://host is the OpenID realm).
STEAM_OAUTH_ENABLED=false
# Steam Web API key (https://steamcommunity.com/dev/apikey) for persona names and avatars: on sign-in, on a Steam
# account's creation / id change and in identity-service's daily refresh. Unset, deadlock-api's keyless copy is used,
# which may lag Steam by months for someone who does not play Deadlock.
# STEAM_WEB_API_KEY=your_steam_web_api_key

OAUTH_REDIRECT=https://owt.craazzzyyfoxx.me/auth/callback

OAUTH_STATE_EXPIRE_MINUTES=10
