# Challonge API credentials (HTTP Basic Auth).
# Required by tournament-service for the admin Challonge sync/import/export.
# Without these the service authenticates with empty credentials and Challonge
# responds 401 (surfaced as a `challonge_error`).
# NOTE: the background worker (serve.py) also reads these — the auto-sync job no-ops
# (with a single warning) when they are missing, so set them for the worker process too.
CHALLONGE_API_KEY=your_challonge_api_key
CHALLONGE_USERNAME=your_challonge_username

# Background Challonge auto-sync (pull Challonge -> local) for active tournaments.
# Runs in the worker on an interval; set CHALLONGE_AUTO_SYNC_ENABLED=false to disable.
CHALLONGE_AUTO_SYNC_ENABLED=true
CHALLONGE_AUTO_SYNC_INTERVAL_MINUTES=5

# Twitch subscription verification, read by the registration and check-in
# admission gates (shared/services/subscriptions/strategies.py). TWITCH_CLIENT_ID
# is the SAME app id identity-service uses for Twitch OAuth. Leaving it unset does
# NOT fail loudly: Twitch resolves `unknown` (`twitch_client_not_configured`),
# which fails open. Boosty (Discord roles) is asked of discord-service over
# RabbitMQ; this service holds no Discord bot token, and a bot outage refuses
# (`provider_unavailable`) instead of admitting.
TWITCH_CLIENT_ID=your_twitch_client_id
# Opens the patrons' stored Twitch tokens (identity seals them). SAME value as auth.env; unset or wrong, every
# token is unusable: logged as an error, and each Twitch check resolves `unknown` (missing_scope).
OAUTH_TOKEN_ENCRYPTION_KEY=
