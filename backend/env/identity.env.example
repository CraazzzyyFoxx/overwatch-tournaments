# identity-svc (headless FastStream) — Phase 1
#
# Most settings come from common.env (POSTGRES_*, REDIS_URL, RABBITMQ_URL) and
# auth.env (JWT_SECRET_KEY, which the JWT signing key is derived from; OAuth
# creds; SERVICE_CLIENTS/SCOPES). This file carries only identity-svc-specific
# overrides; identity-auth-svc (production) reads it too.

# Which RPC modules this process serves: all (default; dev) | core (everything
# but sign-in/sessions/account/OAuth, plus schedulers and startup jobs) |
# credentials (auth + oauth only). Production compose sets it per service
# (identity-svc=core, identity-auth-svc=credentials); leave it unset here.
# IDENTITY_RPC_ROLE=all

# Prometheus worker metrics port (optional; unset = metrics server disabled).
# WORKER_METRICS_PORT=9100

# Seconds the immediately-previous refresh token of a still-active session may be
# rotated once more instead of counting as a reuse attack. Covers a rotation whose
# response never reached the client (the in-flight request died with the old
# network path — a VPN switch); 0 disables the grace and restores hard single-use.
# REFRESH_ROTATION_GRACE_SECONDS=60
