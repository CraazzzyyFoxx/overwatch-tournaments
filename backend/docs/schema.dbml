    (killer_hero_id) [name: "ix_matches_kill_feed_killer_hero_id"]
    (victim_team_id) [name: "ix_matches_kill_feed_victim_team_id"]
    (killer_id) [name: "ix_matches_kill_feed_killer_id"]
    (killer_team_id) [name: "ix_matches_kill_feed_killer_team_id"]
    (match_id) [name: "ix_matches_kill_feed_match_id"]
  }
}

Table matches.match {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
