  rank int
  is_substitute boolean [not null, default: false]
  indexes {
    (encounter_team_id, workspace_member_id) [unique, name: "uq_team_member_member"]
    (workspace_member_id) [name: "ix_team_member_workspace_member_id"]
    (encounter_id, workspace_member_id) [unique, name: "uq_team_member_active_member"]
  }
}

Table encounter.team_member_role {
  team_member_id bigint [pk]
  dimension_id bigint [not null]
  role_id bigint [pk]
  indexes {
    (role_id) [name: "ix_encounter_team_member_role_role_id"]
  }
}

Table encounter.team_report {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
