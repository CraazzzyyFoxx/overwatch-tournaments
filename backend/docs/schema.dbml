// ----- mix -----

Table mix.co_host {
  custom_game_id bigint [pk]
  user_id bigint [pk]
  indexes {
    (user_id) [name: "ix_mix_co_host_user_id"]
  }
}

Table mix.custom_game {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  workspace_id bigint [not null]
  host_user_id bigint
  name VARCHAR(255) [not null]
  status VARCHAR(16) [not null, default: `draft`]
  lobby_count int [not null, default: 1]
  self_signup VARCHAR(16) [not null, default: `closed`]
  self_role_edit boolean [not null, default: false]
  general_voice_channel_id bigint
  discipline VARCHAR(32) [not null, default: `overwatch`]
  scoring_rule_id bigint [not null]
  indexes {
    (id, workspace_id, discipline) [unique, name: "uq_custom_game_owner_key"]
    (host_user_id) [name: "ix_mix_custom_game_host_user_id"]
    (workspace_id) [name: "ix_mix_custom_game_workspace_id"]
  }
}

Table mix.lobby {
  custom_game_id bigint [pk]
  lobby_index int [pk, increment]
  selected_variant_index int [not null, default: 0]
