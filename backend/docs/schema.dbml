  }
}

Table tournament.tournament_phase_schedule {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  tournament_id bigint [not null]
  status tournamentstatus [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz
  indexes {
    (tournament_id, status) [unique, name: "uq_tournament_phase_schedule_phase"]
    (tournament_id) [name: "ix_tournament_tournament_phase_schedule_tournament_id"]
    (starts_at) [name: "ix_tournament_tournament_phase_schedule_starts_at"]
  }
}

Table tournament.tournament_preview_access {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  tournament_id bigint [not null]
  auth_user_id bigint [not null]
  indexes {
    (tournament_id, auth_user_id) [unique, name: "uq_tournament_preview_access_tournament_user"]
    (auth_user_id) [name: "ix_tournament_tournament_preview_access_auth_user_id"]
    (tournament_id) [name: "ix_tournament_tournament_preview_access_tournament_id"]
  }
}

TableGroup tournament {
  tournament.challonge_match_mapping
  tournament.challonge_participant_mapping
  tournament.challonge_source
  tournament.challonge_sync_log
  tournament.computation_job
  tournament.encounter
  tournament.encounter_captain_report
  tournament.encounter_link
  tournament.encounter_map_code
  tournament.encounter_map_report
  tournament.encounter_pick_ban_ledger
  tournament.encounter_readiness
  tournament.encounter_report_form
  tournament.encounter_result_audit
  tournament.encounter_saved_view
  tournament.pick_ban_config
  tournament.pick_ban_config_item
  tournament.pick_ban_config_slot
  tournament.pick_ban_config_slot_item
  tournament.pick_ban_entry
  tournament.pick_ban_session
  tournament.player
  tournament.player_sub_role
  tournament.recalculation_state
  tournament.scrim_room
  tournament.slug_redirect
  tournament.stage
  tournament.stage_item
  tournament.stage_item_input
  tournament.standing
  tournament.team
  tournament.tournament
  tournament.tournament_link
  tournament.tournament_phase_schedule
  tournament.tournament_preview_access
}

