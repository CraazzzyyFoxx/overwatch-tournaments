  team1_voice_channel_id bigint
  team2_voice_channel_id bigint
}

Table mix.player {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  custom_game_id bigint [not null]
  workspace_member_id bigint [not null]
  sort_order int [not null, default: 0]
  participation VARCHAR(16) [not null, default: `pool`]
  role_selection_mode VARCHAR(16) [not null, default: `all_ranked`]
  is_flex boolean [not null, default: false]
  lobby_pin int
  indexes {
    (custom_game_id, workspace_member_id) [unique, name: "uq_custom_game_player_member"]
    (custom_game_id) [name: "ix_mix_player_custom_game_id"]
    (workspace_member_id) [name: "ix_mix_player_workspace_member_id"]
  }
}

Table mix.player_role {
  custom_game_player_id bigint [pk]
  dimension_id bigint [not null]
  role_id bigint [pk]
  priority int [not null]
  indexes {
    (custom_game_player_id, priority) [unique, name: "uq_custom_game_player_role_priority"]
    (role_id) [name: "ix_mix_player_role_role_id"]
  }
}

Table mix.round {
  encounter_id bigint [pk]
  lobby_index int [not null]
  points_per_win_applied int
}

Table mix.round_member {
  encounter_id bigint [pk]
  workspace_member_id bigint [pk]
  busy boolean [not null]
  rank_delta_applied int
  indexes {
    (workspace_member_id) [name: "ix_custom_game_round_member_workspace_member_id"]
  }
}

Table mix.team_name {
  custom_game_id bigint [pk]
  team_index int [pk, increment]
  name VARCHAR(60) [not null]
}

TableGroup mix {
  mix.co_host
  mix.custom_game
  mix.lobby
  mix.player
  mix.player_role
  mix.round
  mix.round_member
  mix.team_name
}

// ----- players -----

Table players.favorite_player {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  auth_user_id bigint [not null]
  player_id bigint [not null]
  indexes {
    (auth_user_id, player_id) [unique, name: "uq_favorite_player_auth_user_player"]
    (auth_user_id) [name: "ix_favorite_player_auth_user"]
    (auth_user_id) [name: "ix_players_favorite_player_auth_user_id"]
    (player_id) [name: "ix_players_favorite_player_player_id"]
  }
}

Table players.social_account {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  user_id bigint [not null]
  provider VARCHAR(64) [not null]
  username VARCHAR(255) [not null]
  username_normalized VARCHAR(255)
  url VARCHAR(500)
  display_name VARCHAR(255)
  provider_user_id VARCHAR(255)
  is_verified boolean [not null, default: false]
  is_primary boolean [not null, default: false]
  indexes {
    (user_id, provider, username_normalized) [unique, name: "uq_social_account_user_provider_handle"]
    (provider) [name: "ix_social_account_provider"]
    (provider_user_id) [name: "ix_social_account_provider_user_id"]
    (user_id) [name: "ix_social_account_user_id"]
    (username_normalized) [name: "ix_social_account_username_normalized"]
    (provider, provider_user_id) [unique, name: "uq_social_account_provider_subject"]
    (user_id, provider) [unique, name: "uq_social_account_user_provider_handle_nullnorm"]
  }
}

Table players.social_account_visibility {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  account_id bigint [not null]
  workspace_id bigint
  indexes {
    (account_id) [name: "ix_social_account_visibility_account_id"]
    (workspace_id) [name: "ix_social_account_visibility_workspace_id"]
    (account_id) [unique, name: "uq_social_visibility_global"]
    (account_id, workspace_id) [unique, name: "uq_social_visibility_workspace"]
  }
}

Table players.user {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  name VARCHAR [not null, unique]
  avatar_url VARCHAR(500)
  stream_visible boolean [not null, default: true]
  auth_user_id bigint [unique]
  indexes {
    (auth_user_id) [unique, name: "ix_players_user_auth_user_id"]
    (name) [name: "ix_user_name_trgm"]
  }
}

Table players.user_merge_audit {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  source_user_id bigint
  target_user_id bigint
  operator_auth_user_id bigint
  field_policy_json json [not null]
  moved_identity_ids_json json [not null]
  deduped_identity_ids_json json [not null]
  affected_counts_json json [not null]
  preview_snapshot_json json [not null]
  indexes {
    (operator_auth_user_id) [name: "ix_players_user_merge_audit_operator_auth_user_id"]
    (source_user_id) [name: "ix_players_user_merge_audit_source_user_id"]
    (target_user_id) [name: "ix_players_user_merge_audit_target_user_id"]
  }
}

TableGroup players {
  players.favorite_player
  players.social_account
  players.social_account_visibility
  players.user
  players.user_merge_audit
}

// ----- public -----

Table audit_log {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  workspace_id bigint
  actor_auth_user_id bigint
  actor_label VARCHAR(255)
  source VARCHAR(16) [not null]
  action VARCHAR(64) [not null]
  entity_type VARCHAR(64)
  entity_id bigint
  entity_label VARCHAR(255)
  before_json jsonb
  after_json jsonb
  reason text
  ip_address VARCHAR(45)
  user_agent VARCHAR(255)
  correlation_id VARCHAR(64)
  indexes {
    (actor_auth_user_id, created_at) [name: "ix_audit_log_actor_created"]
    (entity_type, entity_id, created_at) [name: "ix_audit_log_entity_created"]
    (workspace_id, created_at) [name: "ix_audit_log_workspace_created"]
  }
}

Table chat_message {
  id bigint [pk, increment]
  room_kind VARCHAR(16) [not null]
  room_ref_id bigint [not null]
  auth_user_id bigint [not null]
  author_name text [not null]
  author_role VARCHAR(16) [not null]
  body text [not null]
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  deleted_by_auth_user_id bigint
  indexes {
    (room_kind, room_ref_id, auth_user_id, id) [name: "ix_chat_message_author"]
    (room_kind, room_ref_id, id) [name: "ix_chat_message_room"]
  }
}

Table chat_mute {
  room_kind VARCHAR(16) [pk, increment]
  room_ref_id bigint [pk, increment]
  auth_user_id bigint [pk, increment]
  muted_until timestamptz
  reason text
  created_by_auth_user_id bigint [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table chat_room_settings {
  room_kind VARCHAR(16) [pk, increment]
  room_ref_id bigint [pk, increment]
  spectators_can_read boolean [not null]
  updated_by_auth_user_id bigint [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
}

Table discord_message {
  id bigint [pk, increment]
  channel VARCHAR(32) [not null]
  target VARCHAR(64) [not null]
  dedupe_key VARCHAR(128)
  subject VARCHAR(160) [not null]
  slot VARCHAR(64) [not null]
  kind VARCHAR(64) [not null]
  notification_id bigint
  workspace_id bigint
  status VARCHAR(16) [not null, default: `pending`]
  discord_channel_id bigint
  message_id bigint
  error text
  payload_json json
  card_json json
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  indexes {
    (channel, target, dedupe_key) [unique, name: "uq_discord_message_target"]
    (subject) [name: "ix_discord_message_subject"]
  }
}

Table division_grid {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  workspace_id bigint
  discipline VARCHAR(32) [not null, default: `overwatch`]
  slug VARCHAR [not null]
  name VARCHAR [not null]
  description VARCHAR
  source_workspace_id bigint
  source_grid_id bigint
  source_key VARCHAR(255)
  source_fingerprint VARCHAR(64)
  imported_at timestamptz
  archived_at timestamptz
  indexes {
    (workspace_id, slug) [unique]
    (source_fingerprint) [name: "ix_division_grid_source_fingerprint"]
    (source_grid_id) [name: "ix_division_grid_source_grid_id"]
    (source_key) [name: "ix_division_grid_source_key"]
    (source_workspace_id) [name: "ix_division_grid_source_workspace_id"]
    (workspace_id) [name: "ix_division_grid_workspace_id"]
  }
}

Table division_grid_import_job {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  workspace_id bigint [not null]
  source_workspace_id bigint
  requested_by_user_id bigint
  status VARCHAR(16) [not null, default: `pending`]
  progress int [not null, default: 0]
  request_json json [not null]
  result_json json
  error text
  idempotency_key VARCHAR(255) [not null]
  started_at timestamptz
  finished_at timestamptz
  indexes {
    (workspace_id, idempotency_key) [unique]
    (requested_by_user_id) [name: "ix_division_grid_import_job_requested_by_user_id"]
    (source_workspace_id) [name: "ix_division_grid_import_job_source_workspace_id"]
    (status) [name: "ix_division_grid_import_job_status"]
    (workspace_id) [name: "ix_division_grid_import_job_workspace_id"]
  }
}

Table division_grid_mapping {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  source_version_id bigint [not null]
  target_version_id bigint [not null]
  name VARCHAR [not null]
  is_complete boolean [not null, default: false]
  indexes {
    (source_version_id, target_version_id) [unique]
    (source_version_id) [name: "ix_division_grid_mapping_source_version_id"]
    (target_version_id) [name: "ix_division_grid_mapping_target_version_id"]
  }
}

Table division_grid_mapping_rule {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  mapping_id bigint [not null]
  source_tier_id bigint [not null]
  target_tier_id bigint [not null]
  weight float [not null, default: 1.0]
  is_primary boolean [not null, default: false]
  indexes {
    (mapping_id) [name: "ix_division_grid_mapping_rule_mapping_id"]
    (source_tier_id) [name: "ix_division_grid_mapping_rule_source_tier_id"]
    (target_tier_id) [name: "ix_division_grid_mapping_rule_target_tier_id"]
  }
}

Table division_grid_tier {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  version_id bigint [not null]
  slug VARCHAR [not null]
  number bigint [not null]
  name VARCHAR [not null]
  sort_order bigint [not null]
  rank_min bigint [not null]
  rank_max bigint
  icon_url VARCHAR [not null]
  native_rank_min bigint
  native_rank_max bigint
  canonical_number bigint
  indexes {
    (version_id, slug) [unique]
    (version_id, sort_order) [unique]
    (version_id) [name: "ix_division_grid_tier_version_id"]
  }
}

Table division_grid_version {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  grid_id bigint [not null]
  version bigint [not null]
  label VARCHAR [not null]
  status VARCHAR [not null, default: `draft`]
  created_from_version_id bigint
  published_at timestamptz
  indexes {
    (grid_id, version) [unique]
    (created_from_version_id) [name: "ix_division_grid_version_created_from_version_id"]
    (grid_id) [name: "ix_division_grid_version_grid_id"]
  }
}

Table event_outbox {
  id bigint [pk, increment]
  event_id VARCHAR(64) [not null, unique]
  event_type VARCHAR(128) [not null]
  exchange VARCHAR(255)
  routing_key VARCHAR(255) [not null]
  payload_json json [not null]
  status VARCHAR(16) [not null]
  attempts int [not null]
  next_attempt_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  published_at timestamptz
  last_error text
  indexes {
    (status, next_attempt_at) [name: "ix_event_outbox_status_next_attempt"]
  }
}

Table notification {
  id bigint [pk, increment]
  audience VARCHAR(16) [not null]
  recipient_auth_user_id bigint
  workspace_id bigint
  source_workspace_id bigint
  kind VARCHAR(64) [not null]
  dedupe_key VARCHAR(128)
  payload_json jsonb [not null, default: `'{}'`]
  actor_auth_user_id bigint
  published_at timestamptz [not null, default: `now()`]
  expires_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (audience) [name: "ix_notification_audience_published"]
    (kind, dedupe_key) [name: "ix_notification_dedupe"]
    (recipient_auth_user_id) [name: "ix_notification_recipient_published"]
    (source_workspace_id) [name: "ix_notification_source_workspace_published"]
  }
}

Table notification_preference {
  auth_user_id bigint [pk]
  discord_dm jsonb [not null, default: `'{}'`]
  updated_at timestamptz [not null, default: `now()`]
}

Table notification_read {
  auth_user_id bigint [pk]
  notification_id bigint [pk]
  read_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table notification_workspace_config {
  workspace_id bigint [pk]
  discord_channel_id bigint
  locale VARCHAR(2) [not null, default: `'ru'`]
  broadcast_kinds jsonb [not null, default: `'["registration.opened", "check_in.opened"]'`]
  updated_at timestamptz [not null, default: `now()`]
}

Table settings {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  key VARCHAR [not null, unique]
  value json [not null, default: `{}`]
  description VARCHAR
  updated_by bigint
  indexes {
    (key) [unique, name: "ix_settings_key"]
  }
}

Table workspace {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  slug VARCHAR [not null, unique]
  name VARCHAR [not null]
  description VARCHAR
  icon_url VARCHAR
  tagline VARCHAR(120)
  about text
  discord_url VARCHAR(512)
  twitch_url VARCHAR(512)
  boosty_url VARCHAR(512)
  is_active boolean [not null, default: true]
  is_hidden boolean [not null, default: false]
  timezone VARCHAR(64) [not null, default: `Europe/Moscow`]
  branding_enabled boolean [not null, default: false]
  brand_primary VARCHAR
  brand_secondary VARCHAR
  brand_background VARCHAR
  brand_surface VARCHAR
  brand_accent VARCHAR
  brand_foreground VARCHAR
  brand_muted VARCHAR
  brand_border VARCHAR
  brand_ring VARCHAR
  brand_destructive VARCHAR
  subdomain VARCHAR(63) [unique]
  seo_title VARCHAR
  seo_description VARCHAR
  custom_domain VARCHAR(255) [unique]
  custom_domain_verified_at timestamptz
  custom_domain_verification_token VARCHAR(64)
  discord_guild_id VARCHAR(32) [unique]
  discord_guild_verified_at timestamptz
  discord_guild_verified_by_auth_user_id bigint
  owner_id bigint
  verification_status VARCHAR(16) [not null, default: `unverified`]
  quota_plan_id bigint
  disciplines_enabled VARCHAR(32)[] [not null, default: `'{overwatch}'`]
  newcomer_scope VARCHAR(16) [not null, default: `global`]
  indexes {
    (custom_domain) [unique, name: "ix_workspace_custom_domain"]
    (owner_id) [name: "ix_workspace_owner_id"]
    (quota_plan_id) [name: "ix_workspace_quota_plan_id"]
    (slug) [unique, name: "ix_workspace_slug"]
    (subdomain) [unique, name: "ix_workspace_subdomain"]
  }
}

Table workspace_division_grid_default {
  workspace_id bigint [pk]
  discipline VARCHAR(32) [pk]
  version_id bigint [not null]
  indexes {
    (version_id) [name: "ix_workspace_division_grid_default_version_id"]
  }
}

Table workspace_member {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  workspace_id bigint [not null]
  player_id bigint [not null]
  display_name VARCHAR(255)
  removed_at timestamptz
  observed_only boolean [not null, default: false]
  indexes {
    (id, workspace_id) [unique, name: "uq_workspace_member_id_workspace"]
    (workspace_id, player_id) [unique, name: "uq_workspace_member_workspace_player"]
    (player_id) [name: "ix_workspace_member_player_id"]
    (workspace_id) [name: "ix_workspace_member_workspace_id"]
  }
}

TableGroup public {
  audit_log
  chat_message
  chat_mute
  chat_room_settings
  discord_message
  division_grid
  division_grid_import_job
  division_grid_mapping
  division_grid_mapping_rule
  division_grid_tier
  division_grid_version
  event_outbox
  notification
  notification_preference
  notification_read
  notification_workspace_config
  settings
  workspace
  workspace_division_grid_default
  workspace_member
}

// ----- quota -----

Table quota.api_key_limit {
  api_key_id bigint [pk]
  requests_per_minute int
  heavy_per_day int
  concurrent_heavy int
  max_upload_bytes bigint
  max_items_per_request int
  updated_by bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
}

Table quota.operation {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  slug VARCHAR(64) [not null, unique]
  cost int [not null, default: 1]
  enabled boolean [not null, default: true]
  description text
  indexes {
    (slug) [unique, name: "ix_quota_operation_slug"]
  }
}

Table quota.plan {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  slug VARCHAR(32) [not null, unique]
  title VARCHAR(64) [not null]
  description text
  indexes {
    (slug) [unique, name: "ix_quota_plan_slug"]
  }
}

Table quota.plan_limit {
  plan_id bigint [pk]
  scope VARCHAR(16) [pk, increment]
  requests_per_minute int
  heavy_per_day int
  concurrent_heavy int
  max_upload_bytes bigint
  max_items_per_request int
}

Table quota.workspace_limit {
  workspace_id bigint [pk]
  scope VARCHAR(16) [pk, increment]
  requests_per_minute int
  heavy_per_day int
  concurrent_heavy int
  max_upload_bytes bigint
  max_items_per_request int
  updated_by bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
}

TableGroup quota {
  quota.api_key_limit
  quota.operation
  quota.plan
  quota.plan_limit
  quota.workspace_limit
}

// ----- rank -----

Table rank.account_state {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  discipline VARCHAR(32) [not null]
  social_account_id bigint [not null, unique]
  handle VARCHAR(255) [not null]
  external_id VARCHAR(255)
  region VARCHAR(16)
  last_checked_at timestamptz
  last_success_at timestamptz
  status VARCHAR(32) [not null, default: `pending`]
  consecutive_failures int [not null, default: 0]
  next_eligible_at timestamptz
  last_error text
  priority_tier smallint [not null, default: 0]
  indexes {
    (discipline, status, next_eligible_at, last_checked_at) [name: "ix_account_state_due"]
    (priority_tier, last_checked_at) [name: "ix_account_state_priority"]
  }
}

Table rank.fetch_log {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  discipline VARCHAR(32) [not null]
  social_account_id bigint
  handle VARCHAR(255) [not null]
  status VARCHAR(32) [not null]
  source VARCHAR(32) [not null]
  error text
  snapshots_written int [not null, default: 0]
  indexes {
    (created_at) [name: "ix_fetch_log_created_at"]
    (status, created_at) [name: "ix_fetch_log_status_created"]
  }
}

Table rank.rank_snapshot {
  id bigint [pk, increment]
  discipline VARCHAR(32) [not null]
  user_id bigint [not null]
  social_account_id bigint [not null]
  handle VARCHAR(255) [not null]
  platform VARCHAR(16)
  role VARCHAR(16)
  queue VARCHAR(16)
  division VARCHAR(32)
  tier smallint
  season int
  lp int
  wins int
  losses int
  rank_value int
  mapping_version VARCHAR(64)
  is_ranked boolean [not null, default: true]
  captured_at timestamptz [not null, default: `now()`]
  source VARCHAR(32) [not null, default: `scheduled`]
  indexes {
    (captured_at) [name: "ix_rank_rank_snapshot_captured_at"]
    (social_account_id, role, queue) [name: "ix_rank_snapshot_latest_ranked"]
    (social_account_id, role, platform, queue, captured_at) [name: "ix_rank_snapshot_series_captured"]
    (user_id, captured_at) [name: "ix_rank_snapshot_user_captured"]
  }
}

TableGroup rank {
  rank.account_state
  rank.fetch_log
  rank.rank_snapshot
}

