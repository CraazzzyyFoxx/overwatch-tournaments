    (captain_registration_id) [name: "ix_registration_team_captain_registration_id"]
    (exported_team_id) [name: "ix_registration_team_exported_team_id"]
    (tournament_id) [name: "ix_registration_team_tournament_id"]
    (tournament_id, status) [name: "ix_registration_team_tournament_status"]
    (workspace_id) [name: "ix_registration_team_workspace_id"]
    (tournament_id, name_normalized) [unique, name: "uq_registration_team_name_active"]
  }
}

Table registration.team_invite {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
