  indexes {
    (workspace_id, auth_user_id, provider) [unique, name: "uq_subscription_entitlement_scope"]
    (workspace_id, provider) [name: "ix_subscription_entitlement_workspace_provider"]
    (auth_user_id) [name: "ix_subscriptions_entitlement_auth_user_id"]
    (workspace_id) [name: "ix_subscriptions_entitlement_workspace_id"]
  }
}

Table subscriptions.provider_config {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  workspace_id bigint [not null]
  provider VARCHAR(32) [not null]
  enabled boolean [not null, default: false]
  config_json json [not null, default: `{}`]
  indexes {
    (workspace_id, provider) [unique, name: "uq_subscription_config_workspace_provider"]
    (workspace_id) [name: "ix_subscriptions_provider_config_workspace_id"]
  }
}

Table subscriptions.requirement {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  workspace_id bigint [not null]
  name VARCHAR(64) [not null, default: `default`]
  requirement_json json [not null, default: `{}`]
  is_default boolean [not null, default: false]
  indexes {
    (workspace_id, name) [unique, name: "uq_subscription_requirement_workspace_name"]
    (workspace_id) [name: "ix_subscriptions_requirement_workspace_id"]
  }
}

TableGroup subscriptions {
  subscriptions.check_log
  subscriptions.entitlement
  subscriptions.provider_config
  subscriptions.requirement
}

// ----- tournament -----

Table tournament.bracket_encounter {
  encounter_id bigint [pk]
  tournament_id bigint [not null]
  stage_id bigint
  stage_item_id bigint
  round int [not null]
  indexes {
    (stage_id) [name: "ix_bracket_encounter_stage_id"]
    (stage_item_id) [name: "ix_bracket_encounter_stage_item_id"]
  }
}

Table tournament.challonge_match_mapping {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  source_id bigint [not null]
  challonge_match_id int [not null]
  encounter_id bigint [not null]
