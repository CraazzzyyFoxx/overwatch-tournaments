// ----- achievements -----

Table achievements.evaluation_result {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  achievement_rule_id bigint [not null]
  workspace_member_id bigint [not null]
  tournament_id bigint
  match_id bigint
  qualified_at timestamptz [not null, default: `now()`]
  evidence_json json
  rule_version int [not null]
  run_id uuid
  indexes {
    (achievement_rule_id, workspace_member_id, tournament_id, match_id) [unique, name: "uq_eval_result_rule_user_tournament_match"]
    (workspace_member_id) [name: "ix_achievements_evaluation_result_workspace_member_id"]
    (achievement_rule_id) [name: "ix_achievements_evaluation_result_achievement_rule_id"]
    (tournament_id) [name: "ix_achievements_evaluation_result_tournament_id"]
    (run_id) [name: "ix_achievements_evaluation_result_run_id"]
    (match_id) [name: "ix_achievements_evaluation_result_match_id"]
  }
}

Table achievements.evaluation_run {
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  workspace_id bigint [not null]
  trigger VARCHAR [not null]
  tournament_id bigint
  rules_evaluated int [not null, default: 0]
  results_created int [not null, default: 0]
  results_removed int [not null, default: 0]
  started_at timestamptz [not null, default: `now()`]
  finished_at timestamptz
  status VARCHAR [not null, default: `running`]
  error_message VARCHAR
  id uuid [pk, increment, default: `gen_random_uuid()`]
  indexes {
    (workspace_id) [name: "ix_achievements_evaluation_run_workspace_id"]
    (id) [name: "ix_achievements_evaluation_run_id"]
  }
}

Table achievements.override {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
