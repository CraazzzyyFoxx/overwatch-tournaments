    (match_id, user_id, hero_id) [name: "ix_match_statistics_playtime_r0"]
    (match_id, name, round) [name: "ix_match_statistics_match_name_round"]
    (match_id, user_id, round) [name: "ix_match_statistics_match_user_round"]
    (user_id, hero_id, name) [name: "ix_match_statistics_user_hero_r0"]
  }
}

TableGroup matches {
