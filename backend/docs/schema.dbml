    (user_id) [name: "ix_matches_event_user_id"]
    (related_hero_id) [name: "ix_matches_assists_related_hero_id"]
    (team_id) [name: "ix_matches_event_team_id"]
    (hero_id) [name: "ix_matches_assists_hero_id"]
    (related_user_id) [name: "ix_matches_assists_related_user_id"]
