  last_seen_at timestamptz
  indexes {
    (feed_id, source_record_key) [unique, name: "uq_registration_google_sheet_binding_key"]
    (registration_id) [unique, name: "uq_registration_google_sheet_binding_registration"]
    (feed_id) [name: "ix_registration_google_sheet_binding_feed_id"]
  }
}

Table registration.google_sheet_feed {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
