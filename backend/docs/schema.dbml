  handle VARCHAR(255) [not null]
  handle_normalized VARCHAR(255) [not null]
  indexes {
    (registration_id, provider, position) [unique, name: "uq_registration_identity_position"]
    (registration_id, provider, handle_normalized) [unique, name: "uq_registration_identity_handle"]
    (provider, handle_normalized) [name: "ix_registration_identity_handle"]
    (registration_id) [name: "ix_registration_identity_registration_id"]
  }
}

Table registration.registration {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  tournament_id bigint [not null]
  workspace_member_id bigint
  display_name VARCHAR(255)
  stream_pov boolean [not null, default: false]
  is_reserve boolean [not null, default: false]
  form_version_id bigint
  public_notes text
  organizer_notes text
  exclude_reason VARCHAR(64)
  admin_notes text
  custom_fields_json json
  status VARCHAR(32) [not null, default: `pending`]
  balancer_status VARCHAR(32) [not null, default: `not_in_balancer`]
  checked_in boolean [not null, default: false]
  checked_in_at timestamptz
  checked_in_by bigint
  submitted_at timestamptz [not null, default: `now()`]
  reviewed_at timestamptz
  reviewed_by bigint
  deleted_at timestamptz
  deleted_by bigint
  balancer_profile_overridden_at timestamptz
  registration_team_id bigint
  team_slot_code VARCHAR(16)
  is_substitute boolean [not null, default: false]
  is_team_manager boolean [not null, default: false]
  indexes {
    (form_version_id) [name: "ix_registration_registration_form_version_id"]
    (registration_team_id) [name: "ix_registration_registration_registration_team_id"]
    (tournament_id) [name: "ix_registration_registration_tournament_id"]
    (workspace_member_id) [name: "ix_registration_registration_workspace_member_id"]
    (tournament_id, status, balancer_status) [name: "ix_registration_tournament_balancer_status"]
    (tournament_id, workspace_member_id) [unique, name: "uq_registration_user"]
  }
}

Table registration.role {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  registration_id bigint [not null]
  dimension_id bigint [not null]
  role_id bigint [not null]
  is_primary boolean [not null, default: false]
  priority int [not null, default: 0]
  rank_value int
  is_active boolean [not null, default: true]
  indexes {
    (registration_id, role_id) [unique, name: "uq_registration_role_role"]
    (registration_id) [name: "ix_registration_role_registration_id"]
    (role_id) [name: "ix_registration_role_role_id"]
  }
}

Table registration.role_entity {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
