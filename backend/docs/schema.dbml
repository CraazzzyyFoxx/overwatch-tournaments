// ----- stats -----

Table stats.discord_channel {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  tournament_id bigint [not null, unique]
  channel_id bigint [not null, unique]
  channel_name VARCHAR(100)
  is_active boolean [not null]
  last_scanned_message_id bigint
  indexes {
    (channel_id) [unique, name: "ix_stats_discord_channel_channel_id"]
  }
}

Table stats.event {
  id bigint [pk, increment]
  match_id bigint [not null]
  segment smallint [not null, default: 0]
  t float8 [not null]
  type_id smallint [not null]
  actor_member_id bigint
  actor_team_id bigint
  target_member_id bigint
  target_team_id bigint
  entity_id bigint
  related_entity_id bigint
  entity_kind VARCHAR(16) [not null, default: `character`]
  data jsonb
  indexes {
    (match_id, t) [name: "ix_event_match"]
  }
}

Table stats.event_type {
  id smallint [pk, increment]
  discipline VARCHAR(32) [not null]
  code VARCHAR(64) [not null]
  name VARCHAR(128) [not null]
  active boolean [not null, default: true]
  indexes {
    (discipline, code) [unique, name: "uq_event_type_code"]
  }
}

Table stats.fact {
  match_id bigint [not null]
  segment smallint [not null, default: 0]
  encounter_team_id bigint [not null]
  workspace_member_id bigint
  entity_id bigint
  entity_kind VARCHAR(16) [not null, default: `character`]
  stat_id smallint [not null]
  value float8 [not null]
  indexes {
    (match_id, segment, encounter_team_id, workspace_member_id, entity_id, stat_id) [unique, name: "uq_fact"]
    (match_id, workspace_member_id, segment) [name: "ix_fact_match_member"]
    (workspace_member_id, entity_id, stat_id) [name: "ix_fact_member_entity_total"]
    (workspace_member_id, stat_id) [name: "ix_fact_member_stat_total"]
    (stat_id, value) [name: "ix_fact_stat_value_total"]
  }
}

Table stats.ingest_job {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  workspace_id bigint [not null]
  discipline VARCHAR(32) [not null]
  source_kind VARCHAR(32) [not null]
  external_id VARCHAR(128)
  content_hash CHAR(64)
  raw_status ck_ingest_job_raw_status [not null, default: `available`]
  filename VARCHAR(500)
  raw_ref VARCHAR(512) [not null]
  document_ref VARCHAR(512)
  status ck_ingest_job_status [not null]
  attempts int [not null, default: 0]
  error_message text
  uploader_user_id bigint
  api_key_id bigint
  hint_tournament_id bigint
  hint_encounter_id bigint
  hint_encounter_game_id bigint
  started_at timestamptz
  finished_at timestamptz
  indexes {
    (api_key_id) [name: "ix_ingest_job_api_key"]
    (hint_encounter_id) [name: "ix_ingest_job_encounter"]
    (hint_encounter_game_id) [name: "ix_ingest_job_game"]
    (status, created_at) [name: "ix_ingest_job_status"]
    (hint_tournament_id) [name: "ix_ingest_job_tournament"]
    (uploader_user_id) [name: "ix_ingest_job_uploader"]
    (workspace_id, source_kind, external_id) [unique, name: "uq_ingest_job_external"]
    (workspace_id, content_hash) [unique, name: "uq_ingest_job_hash"]
  }
}

Table stats.match {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  workspace_id bigint [not null]
  discipline VARCHAR(32) [not null]
  encounter_id bigint [not null]
  encounter_game_id bigint
  source_map_index int
  ingest_job_id bigint
  revision int [not null, default: 1]
  played_at timestamptz
  duration_s float8
  map_entity_id bigint [not null]
  map_kind VARCHAR(16) [not null, default: `map`]
  mode_entity_id bigint
  mode_kind VARCHAR(16) [not null, default: `mode`]
  indexes {
    (encounter_game_id) [unique, name: "uq_stats_match_game"]
    (id, encounter_id) [unique, name: "uq_stats_match_owner"]
    (encounter_id) [name: "ix_stats_match_encounter"]
    (ingest_job_id) [name: "ix_stats_match_ingest_job"]
    (workspace_id) [name: "ix_stats_match_workspace"]
  }
}

Table stats.match_fetch {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  workspace_id bigint [not null]
  discipline VARCHAR(32) [not null]
  source_kind VARCHAR(32) [not null]
  external_id VARCHAR(128) [not null]
  hint_tournament_id bigint [not null]
  hint_encounter_id bigint [not null]
  hint_encounter_game_id bigint [not null]
  requested_by_user_id bigint
  status ck_match_fetch_status [not null, default: `pending`]
  attempts int [not null, default: 0]
  next_attempt_at timestamptz [not null, default: `now()`]
  last_error text
  ingest_job_id bigint
  indexes {
    (source_kind, external_id, hint_encounter_game_id) [unique, name: "uq_match_fetch_game"]
    (status, next_attempt_at) [name: "ix_match_fetch_due"]
    (workspace_id, source_kind, external_id) [name: "ix_match_fetch_workspace_external"]
  }
}

Table stats.match_player {
  match_id bigint [pk]
  encounter_team_id bigint [not null]
  workspace_member_id bigint [pk]
  handle_snapshot VARCHAR(255) [not null]
  observed_role_id bigint
  indexes {
    (workspace_member_id) [name: "ix_match_player_member"]
    (observed_role_id) [name: "ix_match_player_observed_role"]
  }
}

Table stats.match_team {
  match_id bigint [pk]
  encounter_id bigint [not null]
  encounter_team_id bigint [pk]
  source_position int [not null]
  indexes {
    (match_id, source_position) [unique, name: "uq_match_team_source_position"]
    (encounter_team_id, encounter_id) [name: "ix_match_team_encounter_team"]
  }
}

Table stats.segment {
  match_id bigint [pk]
  segment smallint [pk, increment]
  kind VARCHAR(16) [not null]
  attrs jsonb [not null, default: `'{}'::jsonb`]
}

Table stats.stat_baseline {
  id bigint [pk, increment]
  formula_version VARCHAR(64) [not null]
  role_id bigint [not null]
  rank_bucket smallint [not null, default: -1]
  stat_id smallint [not null]
  mean float8 [not null]
  std float8 [not null]
  meta jsonb
  computed_at timestamptz [not null, default: `now()`]
  indexes {
    (formula_version, role_id, rank_bucket, stat_id) [unique, name: "uq_stat_baseline"]
    (role_id) [name: "ix_stat_baseline_role"]
  }
}

Table stats.stat_def {
  id smallint [pk, increment]
  discipline VARCHAR(32) [not null]
  code VARCHAR(64) [not null]
  name VARCHAR(128) [not null]
  value_format VARCHAR(16) [not null]
  aggregation VARCHAR(8) [not null]
  stat_group VARCHAR(32)
  active boolean [not null, default: true]
  sort_order int [not null, default: 0]
  indexes {
    (discipline, code) [unique, name: "uq_stat_def_code"]
  }
}

TableGroup stats {
  stats.discord_channel
  stats.event
  stats.event_type
  stats.fact
  stats.ingest_job
  stats.match
  stats.match_fetch
  stats.match_player
  stats.match_team
  stats.segment
  stats.stat_baseline
  stats.stat_def
}

// ----- subscriptions -----

Table subscriptions.check_log {
