  auto_sync_interval_seconds int [not null, default: 300]
  header_row_json json
  mapping_config_json json
  value_mapping_json json
  last_synced_at timestamptz
  last_sync_status VARCHAR(32)
  last_error text
  indexes {
    (tournament_id) [unique, name: "uq_registration_google_sheet_feed_tournament"]
  }
}

Table registration.identity {
  id bigint [pk, increment]
