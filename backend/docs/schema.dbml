  excludes_from_ready boolean [not null, default: false]
  indexes {
    (workspace_id, scope, slug, kind) [unique, name: "uq_registration_status_workspace_scope_slug"]
    (workspace_id) [name: "ix_registration_status_workspace_id"]
    (workspace_id, scope) [name: "ix_registration_status_workspace_scope"]
  }
}

Table registration.team {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
