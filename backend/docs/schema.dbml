  encounter_team_id bigint [not null]
  reporter_user_id bigint
  games_played int
  basis_version bigint [not null]
  closeness int
  comment text
  custom_fields_json json [not null, default: `{}`]
  indexes {
    (id, encounter_id) [unique, name: "uq_team_report_id_encounter"]
    (encounter_id, encounter_team_id) [unique, name: "uq_team_report_claimant"]
  }
}

Table encounter.team_report_result {
  report_id bigint [pk]
  encounter_id bigint [not null]
  encounter_team_id bigint [pk]
  score float [not null]
  placement int
  wins int
}

TableGroup encounter {
  encounter.encounter
  encounter.game
  encounter.game_claim
  encounter.game_claim_result
