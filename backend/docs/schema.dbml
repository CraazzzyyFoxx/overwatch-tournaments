    (home_team_id) [name: "ix_matches_match_home_team_id"]
    (map_id) [name: "ix_matches_match_map_id"]
  }
}

Table matches.stat_baselines {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
