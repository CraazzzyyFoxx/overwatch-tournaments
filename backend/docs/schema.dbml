  entity_id bigint [not null]
  entity_kind VARCHAR(16) [not null, default: `character`]
  priority int [not null]
  indexes {
    (role_id, entity_id) [unique, name: "uq_reg_role_entity_role_entity"]
    (role_id, priority) [unique, name: "uq_reg_role_entity_role_priority"]
    (role_id) [name: "ix_registration_role_entity_role_id"]
  }
}

Table registration.status {
  id bigint [pk, increment]
