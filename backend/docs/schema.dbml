  realtime.workspace_event
}

// ----- registration -----

Table registration.form {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  tournament_id bigint [not null]
  workspace_id bigint [not null]
  is_open boolean [not null, default: false]
  auto_approve boolean [not null, default: false]
  current_version_id bigint
  require_open_profile boolean [not null, default: false]
  open_profile_scope VARCHAR(8) [not null, default: `main`]
  show_ranks boolean [not null, default: false]
  hide_registrations boolean [not null, default: false]
  max_participants int
  max_substitutes int [not null, default: 0]
  require_subscription boolean [not null, default: false]
  subscription_stage VARCHAR(16) [not null, default: `check_in`]
  subscription_scope VARCHAR(16) [not null, default: `player`]
  team_rank_min int
  team_rank_max int
  team_max_rank_spread int
  team_unique_identity boolean [not null, default: false]
  team_require_discord_guild boolean [not null, default: false]
  indexes {
    (tournament_id) [unique, name: "uq_registration_form_tournament"]
    (workspace_id) [name: "ix_registration_form_workspace_id"]
  }
}

Table registration.form_template {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
