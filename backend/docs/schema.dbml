    (target_auth_user_id) [name: "ix_registration_team_invite_target_auth_user_id"]
    (team_id) [name: "ix_registration_team_invite_team_id"]
    (team_id, state) [name: "ix_registration_team_invite_team_state"]
    (token_sha256) [unique, name: "uq_registration_team_invite_token"]
  }
}

TableGroup registration {
  registration.form
