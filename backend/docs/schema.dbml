  battle_tag_normalized VARCHAR(255)
  dimension_id bigint
  role_id bigint
  assigned_rank int [not null]
  discomfort int [not null, default: 0]
  is_captain boolean [not null, default: false]
  sort_order int [not null, default: 0]
  indexes {
    (battle_tag_normalized) [name: "ix_balancer_team_slot_battle_tag_normalized"]
    (role_id) [name: "ix_balancer_team_slot_role_id"]
    (team_id) [name: "ix_balancer_team_slot_team_id"]
  }
}

Table balancer.tournament_config {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  tournament_id bigint [not null]
  workspace_id bigint [not null]
  config_json json [not null, default: `{}`]
  updated_by bigint
  indexes {
    (tournament_id) [unique, name: "uq_balancer_tournament_config_tournament"]
    (workspace_id) [name: "ix_balancer_tournament_config_workspace_id"]
  }
}

Table balancer.user_config {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  user_id bigint [not null]
  config_json jsonb [not null, default: `{}`]
  points_per_win int
  rating_mode VARCHAR(16) [not null, default: `points`]
  indexes {
    (user_id) [unique, name: "uq_balancer_user_config_user"]
  }
}

Table balancer.workspace_config {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  workspace_id bigint [not null]
  config_json json [not null, default: `{}`]
  updated_by bigint
  ranker_json jsonb
  indexes {
    (workspace_id) [unique, name: "uq_balancer_workspace_config_workspace"]
  }
}

TableGroup balancer {
  balancer.balance
  balancer.balance_variant
  balancer.member_hidden_rating
  balancer.member_rank
  balancer.team
  balancer.team_slot
  balancer.tournament_config
  balancer.user_config
  balancer.workspace_config
}

// ----- catalog -----

Table catalog.alias_miss {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  discipline VARCHAR(32) [not null]
  kind VARCHAR(16) [not null]
  raw_name VARCHAR(128) [not null]
  occurrences int [not null, default: 1]
  first_seen_at timestamptz [not null, default: `now()`]
  last_seen_at timestamptz [not null, default: `now()`]
  last_ingest_job_id bigint
  resolved_at timestamptz
  indexes {
    (discipline, kind, raw_name) [unique, name: "uq_alias_miss"]
    (last_ingest_job_id) [name: "ix_alias_miss_ingest_job"]
  }
}

Table catalog.discipline {
  code VARCHAR(32) [pk, increment]
  name VARCHAR(64) [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table catalog.entity {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  discipline VARCHAR(32) [not null]
  kind VARCHAR(16) [not null]
  slug VARCHAR(64) [not null]
  name VARCHAR(128) [not null]
  image_path VARCHAR
  parent_id bigint
  attrs jsonb [not null, default: `'{}'::jsonb`]
  aliases jsonb [not null, default: `'[]'::jsonb`]
  active boolean [not null, default: true]
  indexes {
    (discipline, kind, name) [unique, name: "uq_entity_name"]
    (id, discipline) [unique, name: "uq_entity_id_discipline"]
    (discipline, kind, slug) [unique, name: "uq_entity_slug"]
    (id, kind) [unique, name: "uq_entity_id_kind"]
    (id, discipline, kind) [unique, name: "uq_entity_key"]
  }
}

Table catalog.role {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  dimension_id bigint [not null]
  workspace_id bigint
  parent_role_id bigint
  code VARCHAR(64) [not null]
  name VARCHAR(128) [not null]
  description text
  selectable boolean [not null, default: true]
  active boolean [not null, default: true]
  sort_order int [not null, default: 0]
  attrs jsonb [not null, default: `'{}'::jsonb`]
  indexes {
    (id, dimension_id) [unique, name: "uq_role_key"]
    (dimension_id, code) [unique, name: "uq_role_module_code"]
    (dimension_id, workspace_id, code) [unique, name: "uq_role_workspace_code"]
  }
}

Table catalog.role_dimension {
  id bigint [pk, increment]
  discipline VARCHAR(32) [not null]
  code VARCHAR(32) [not null]
  name VARCHAR(64) [not null]
  selection_mode VARCHAR(8) [not null]
  rated boolean [not null, default: false]
  active boolean [not null, default: true]
  sort_order int [not null, default: 0]
  indexes {
    (discipline, code) [unique, name: "uq_role_dimension_code"]
    (id, discipline) [unique, name: "uq_role_dimension_key"]
    (discipline) [unique, name: "uq_role_dimension_rated"]
  }
}

TableGroup catalog {
  catalog.alias_miss
  catalog.discipline
  catalog.entity
  catalog.role
  catalog.role_dimension
}

// ----- draft -----

Table draft.audit_event {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  session_id bigint [not null]
  actor_auth_user_id bigint
  action VARCHAR(64) [not null]
  entity_type VARCHAR(64) [not null]
  entity_id bigint [not null]
  reason text [not null]
  before_json json [not null]
  after_json json [not null]
  indexes {
    (actor_auth_user_id) [name: "ix_draft_audit_event_actor_auth_user_id"]
    (session_id, created_at) [name: "ix_draft_audit_session_created"]
  }
}

Table draft.pick {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  session_id bigint [not null]
  overall_no int [not null]
  round_no int [not null]
  pick_in_round int [not null]
  draft_team_id bigint [not null]
  dimension_id bigint
  target_role_id bigint
  target_rank_value int
  status VARCHAR(16) [not null, default: `upcoming`]
  picked_player_id bigint
  picked_by_workspace_member_id bigint
  is_autopick boolean [not null, default: false]
  is_admin_override boolean [not null, default: false]
  clock_started_at timestamptz
  clock_expires_at timestamptz
  clock_remaining_ms int
  overtime_started_at timestamptz
  version int [not null, default: 0]
  indexes {
    (session_id, overall_no) [unique, name: "uq_draft_pick_session_overall"]
    (draft_team_id) [name: "ix_draft_pick_draft_team_id"]
    (picked_player_id) [name: "ix_draft_pick_picked_player_id"]
    (session_id, status) [name: "ix_draft_pick_session_status"]
    (target_role_id) [name: "ix_draft_pick_target_role_id"]
  }
}

Table draft.player {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  session_id bigint [not null]
  registration_id bigint [not null]
  workspace_member_id bigint
  status VARCHAR(16) [not null, default: `available`]
  is_captain boolean [not null, default: false]
  drafted_by_team_id bigint
  dimension_id bigint
  captain_role_id bigint
  version int [not null, default: 0]
  indexes {
    (session_id, registration_id) [unique, name: "uq_draft_player_session_registration"]
    (captain_role_id) [name: "ix_draft_player_captain_role_id"]
    (drafted_by_team_id) [name: "ix_draft_player_drafted_by_team_id"]
    (registration_id) [name: "ix_draft_player_registration_id"]
    (session_id, status) [name: "ix_draft_player_session_status"]
    (workspace_member_id) [name: "ix_draft_player_workspace_member_id"]
  }
}

Table draft.session {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  tournament_id bigint [not null]
  workspace_id bigint [not null]
  status VARCHAR(16) [not null, default: `setup`]
  blocked_reason VARCHAR(64)
  format VARCHAR(16) [not null, default: `snake`]
  rounds int [not null, default: 4]
  pick_time_seconds int [not null, default: 45]
  overtime_seconds int [not null, default: 0]
  current_pick_id bigint
  pool_source VARCHAR(32) [not null, default: `balancer_balance`]
  source_balance_id bigint
  autopick_strategy VARCHAR(16) [not null, default: `best_fit`]
  allow_admin_override boolean [not null, default: true]
  exported_at timestamptz
  export_status VARCHAR(32)
  settings_json json [not null, default: `{}`]
  version int [not null, default: 0]
  indexes {
    (source_balance_id) [name: "ix_draft_session_source_balance_id"]
    (status, created_at) [name: "ix_draft_session_status_created"]
    (tournament_id, status) [name: "ix_draft_session_tournament_status"]
    (workspace_id) [name: "ix_draft_session_workspace_id"]
    (tournament_id) [unique, name: "uq_draft_session_active_tournament"]
  }
}

Table draft.team {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  session_id bigint [not null]
  captain_workspace_member_id bigint
  captain_auth_user_id bigint
  name VARCHAR(255) [not null]
  draft_position int [not null]
  exported_team_id bigint
  pick_queue jsonb [not null, default: `[]`]
  indexes {
    (session_id, draft_position) [unique, name: "uq_draft_team_session_position"]
    (captain_auth_user_id) [name: "ix_draft_team_captain_auth_user_id"]
    (captain_workspace_member_id) [name: "ix_draft_team_captain_workspace_member_id"]
    (exported_team_id) [name: "ix_draft_team_exported_team_id"]
    (session_id) [name: "ix_draft_team_session_id"]
  }
}

TableGroup draft {
  draft.audit_event
  draft.pick
  draft.player
  draft.session
  draft.team
}

// ----- encounter -----

Table encounter.encounter {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  workspace_id bigint [not null]
  discipline VARCHAR(32) [not null]
  tournament_id bigint
  custom_game_id bigint
  scoring_rule_id bigint [not null]
  name VARCHAR [not null]
  slot_count int [not null]
  best_of int [not null, default: 3]
  status encounterstatus [not null]
  result_status encounterresultstatus [not null, default: `none`]
  result_source VARCHAR(16)
  result_version bigint [not null, default: 0]
  current_game_position int
  closeness float
  scheduled_at timestamptz
  started_at timestamptz
  ended_at timestamptz
  confirmed_at timestamptz
  indexes {
    (id, tournament_id) [unique, name: "uq_encounter_id_tournament"]
    (custom_game_id) [name: "ix_encounter_custom_game_id"]
    (ended_at) [name: "ix_encounter_ended_at"]
    (scheduled_at) [name: "ix_encounter_scheduled_at"]
    (started_at) [name: "ix_encounter_started_at"]
    (tournament_id, status) [name: "ix_encounter_status_live_upcoming"]
    (tournament_id, status) [name: "ix_encounter_tournament_status"]
    (workspace_id) [name: "ix_encounter_workspace_id"]
  }
}

Table encounter.game {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  encounter_id bigint [not null]
  position int [not null]
  map_id bigint
  map_kind VARCHAR(16) [not null, default: `map`]
  mode_id bigint
  mode_kind VARCHAR(16) [not null, default: `mode`]
  state encountergamestate [not null, default: `planned`]
  result_source encountergameresultsource
  result_version int [not null, default: 0]
  confirmed_at timestamptz
  indexes {
    (id, encounter_id) [unique, name: "uq_game_id_encounter"]
    (encounter_id) [name: "ix_game_encounter_id"]
    (map_id) [name: "ix_game_map_id"]
    (mode_id) [name: "ix_game_mode_id"]
    (encounter_id, position) [unique, name: "uq_game_encounter_position"]
  }
}

Table encounter.game_claim {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  encounter_id bigint [not null]
  game_id bigint [not null]
  claimant_team_id bigint [not null]
  reporter_user_id bigint
  basis_version int [not null]
  indexes {
    (id, game_id) [unique, name: "uq_game_claim_id_game"]
    (game_id, claimant_team_id) [unique, name: "uq_game_claim_claimant"]
  }
}

Table encounter.game_claim_result {
  claim_id bigint [pk]
  game_id bigint [not null]
  encounter_team_id bigint [pk]
  score int
  placement int
  column_values jsonb [not null, default: `'{}'::jsonb`]
}

Table encounter.game_team {
  game_id bigint [pk]
  encounter_id bigint [not null]
  encounter_team_id bigint [pk]
  score int
  placement int
  column_values jsonb [not null, default: `'{}'::jsonb`]
  starting_side VARCHAR(16)
  replay_code VARCHAR(32)
  indexes {
    (encounter_team_id) [name: "ix_game_team_team"]
    (game_id, starting_side) [unique, name: "uq_game_team_side"]
  }
}

Table encounter.pick_ban_entry {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  session_id bigint [not null]
  encounter_id bigint [not null]
  item_id int [not null]
  "order" int [not null]
  action_index int
  round int
  picked_by_kind pickbanactor
  picked_by_team_id bigint
  status pickbanentrystatus [not null, default: `available`]
  protected_by_kind pickbanactor
  protected_by_team_id bigint
  carried_from_round int
  indexes {
    (item_id) [name: "ix_pick_ban_entry_item_id"]
    (session_id) [name: "ix_pick_ban_entry_session_id"]
  }
}

Table encounter.pick_ban_session {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  encounter_id bigint [not null]
  kind pickbankind [not null]
  pool_json json [not null]
  first_team_id bigint
  seed_source pickbanseedsource [not null]
  resolved_sequence_json json [not null]
  slot_reserves_json json
  ruleset_json json [not null]
  status pickbansessionstatus [not null, default: `active`]
  awaiting_choice boolean [not null, default: false]
  pending_chooser_team_id bigint
  undo_requested_by_team_id bigint
  undo_target_index int
  started_at timestamptz
  current_step_started_at timestamptz
  paused_at timestamptz
  indexes {
    (id, encounter_id) [unique, name: "uq_pick_ban_session_id_encounter"]
    (encounter_id, kind) [unique, name: "uq_pick_ban_session_encounter_kind"]
    (encounter_id) [name: "ix_pick_ban_session_encounter_id"]
  }
}

Table encounter.pick_ban_submission {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  session_id bigint [not null]
  encounter_id bigint [not null]
  step_index int [not null]
  encounter_team_id bigint
  attempt int [not null, default: 1]
  state VARCHAR(16) [not null]
  items_json json [not null, default: `[]`]
  locked_at timestamptz
  revealed_at timestamptz
  indexes {
    (session_id) [name: "ix_pick_ban_submission_session_id"]
    (session_id, step_index, encounter_team_id, attempt) [unique, name: "uq_pick_ban_submission_step_team_attempt"]
  }
}

Table encounter.readiness {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  encounter_id bigint [not null]
  encounter_team_id bigint [not null]
  ready_user_id bigint
  indexes {
    (encounter_id, encounter_team_id) [unique, name: "uq_readiness_team"]
  }
}

Table encounter.result_audit {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  encounter_id bigint [not null]
  result_version bigint [not null]
  snapshot_scope VARCHAR(16) [not null]
  game_id bigint
  game_result_version int
  actor_user_id bigint
  action encounterresultauditaction [not null]
  from_result_status encounterresultstatus
  to_result_status encounterresultstatus [not null]
  before jsonb
  after jsonb [not null]
  adopted_team_id bigint
  reason text
  source VARCHAR(32) [not null]
  indexes {
    (encounter_id, result_version) [unique, name: "uq_result_audit_version"]
    (encounter_id, created_at) [name: "ix_encounter_result_audit_encounter_created"]
    (game_id) [name: "ix_result_audit_game_id"]
  }
}

Table encounter.room_event {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  encounter_id bigint [not null]
  kind VARCHAR(8)
  action VARCHAR(64) [not null]
  source VARCHAR(16) [not null]
  encounter_team_id bigint
  actor_auth_user_id bigint
  reason text
  data json [not null, default: `{}`]
  indexes {
    (encounter_id, created_at) [name: "ix_encounter_room_event_encounter_created"]
  }
}

Table encounter.scoring_rule {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  workspace_id bigint [not null]
  preset VARCHAR(16) [not null]
  columns jsonb [not null, default: `'[]'::jsonb`]
  placement_points FLOAT[] [not null, default: `{}`]
  game_formula VARCHAR(500) [not null]
  end_formula VARCHAR(500) [not null]
  indexes {
    (id, workspace_id) [unique, name: "uq_scoring_rule_id_workspace"]
  }
}

Table encounter.team {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  encounter_id bigint [not null]
  tournament_id bigint
  slot int [not null]
  team_id bigint
  name VARCHAR(255) [not null]
  seed int
  active boolean [not null, default: true]
  score float [not null, default: 0]
  placement int
  indexes {
    (id, encounter_id) [unique, name: "uq_team_id_encounter"]
    (id, encounter_id, active) [unique, name: "uq_team_id_encounter_active"]
    (team_id) [name: "ix_team_team_id"]
    (encounter_id, slot) [unique, name: "uq_team_active_slot"]
    (encounter_id, team_id) [unique, name: "uq_team_active_source"]
  }
}

Table encounter.team_member {
  id bigint [pk, increment]
  created_at timestamptz [not null, default: `now()`]
