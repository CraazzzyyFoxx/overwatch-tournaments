# Dummy values so every service Settings() can construct without docker-compose
# env files. Loaded last: process env and a local .env win.
#
# POSTGRES_* matches docker-compose.test.yml (repo root). Host-run pytest
# probes 127.0.0.1:55432; if nothing is there it starts that compose file.
# Do not point this at production names (anak_v5 / anak_prod).

PROJECT_URL=http://localhost
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=anak_test
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_ENDPOINT_URL=http://localhost
S3_BUCKET_NAME=test

CHALLONGE_USERNAME=test
CHALLONGE_API_KEY=test

JWT_SECRET_KEY=test-secret
DISCORD_CLIENT_ID=discord-client
DISCORD_CLIENT_SECRET=discord-secret
TWITCH_CLIENT_ID=twitch-client
TWITCH_CLIENT_SECRET=twitch-secret
BATTLENET_CLIENT_ID=battlenet-client
BATTLENET_CLIENT_SECRET=battlenet-secret
OAUTH_REDIRECT=http://localhost:3000/auth/callback

DISCORD_TOKEN=dummy_token
PARSER_URL=http://parser:8002
SERVICE_CLIENT_ID=dummy_id
SERVICE_CLIENT_SECRET=dummy_secret
