/.superpowers/

# Logs
logs/
# `logs/` above is for runtime logs. Any `logs` segment under the frontend
# source tree is code (a route, `components/logs`, `lib/logs`), not output —
# this used to name one exact path and silently dropped new files beside it.
!frontend/src/**/logs/

